# Observer location
# Latitude and longitude use decimal degrees. Elevation is metres above sea level.
OBSERVER_LAT=
OBSERVER_LON=
OBSERVER_ELEVATION_M=
# Local transition altitude in feet. Reserved for later operational logic.
TRANSITION_ALTITUDE_FT=

# ADS-B source
# Host may be an IP address or hostname. Port is the TCP source port.
ADSB_HOST=127.0.0.1
ADSB_PORT=30003
# IANA timezone used by the ADS-B source for naive SBS timestamps.
ADSB_TIMESTAMP_TIMEZONE=Europe/Warsaw

# MLAT source
# Host may be an IP address or hostname. Port is the TCP source port.
MLAT_HOST=127.0.0.1
MLAT_PORT=30106

# METAR source
# Four-letter ICAO station identifier used to retrieve METAR data from AWC.
METAR_STATION=EPRA
