# Observer location
# Latitude and longitude use decimal degrees. Elevation is metres above sea level.
OBSERVER_LAT=
OBSERVER_LON=
OBSERVER_ELEVATION_M=
OBSERVER_MODE=STATIC
MOBILE_GPS_STALE_WARNING_SECONDS=30
MOBILE_GPS_CRITICAL_WARNING_SECONDS=300
MOBILE_GPS_STATIC_FALLBACK_ENABLED=false
# Local transition altitude in feet. Reserved for later operational logic.
TRANSITION_ALTITUDE_FT=

# ADS-B source
# Host may be an IP address or hostname. Port is the TCP source port.
ADSB_HOST=127.0.0.1
ADSB_PORT=30003
# IANA timezone used by the ADS-B source for naive SBS timestamps.
ADSB_TIMESTAMP_TIMEZONE=Europe/Warsaw

# Optional RAW ADS-B source for high-precision TC19 ground track
# Host may be an IP address or hostname. Port is the RAW TCP source port.
RAW_ADSB_HOST=127.0.0.1
RAW_ADSB_PORT=30002

# Production geometric-altitude selection remains opt-in.
GEOMETRIC_ALTITUDE_SELECTION_ENABLED=false
# Optional fleet geometric-altitude diagnostics. The same estimator also feeds
# production selection when GEOMETRIC_ALTITUDE_SELECTION_ENABLED=true.
FLEET_GEOMETRIC_ALTITUDE_ENABLED=false
# Optional GeographicLib EGM96 PGM path; leave empty for platform discovery.
FLEET_GEOID_PGM_PATH=

# Beast/Mode-S source used for TC29 selected-altitude intent
BEAST_HOST=127.0.0.1
BEAST_PORT=30005

# MLAT source
# Host may be an IP address or hostname. Port is the TCP source port.
MLAT_HOST=127.0.0.1
MLAT_PORT=30106
# Optional FlightAware synthetic MLAT Beast precision-track source.
MLAT_BEAST_ENABLED=false
MLAT_BEAST_HOST=127.0.0.1
MLAT_BEAST_PORT=30105

# METAR source
# Four-letter ICAO station identifier used to retrieve METAR data from AWC.
METAR_STATION=

# Optional outgoing Telegram transit notifications
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_SEPARATION_DEG=2.0
TELEGRAM_ALERT_HORIZON_SECONDS=300
TELEGRAM_ALERT_STABILITY_SECONDS=5
TELEGRAM_SUN_ENABLED=true
TELEGRAM_MOON_ENABLED=true

# Terminal/tmux presentation thresholds in degrees (GREEN < YELLOW < VISIBLE)
TMUX_SEP_GREEN_MAX_DEG=3
TMUX_SEP_YELLOW_MAX_DEG=5
TMUX_SEP_VISIBLE_MAX_DEG=7

# Optional local read-only web dashboard (localhost-only by default)
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_HISTORY_ENABLED=true
DASHBOARD_HISTORY_DIR=recordings/dashboard_history
DASHBOARD_MOBILE_GPS_ENABLED=false
DASHBOARD_MOBILE_GPS_FRESH_SECONDS=15
# Dashboard presentation thresholds in degrees (GREEN < YELLOW < VISIBLE)
DASHBOARD_SEP_GREEN_MAX_DEG=3
DASHBOARD_SEP_YELLOW_MAX_DEG=5
DASHBOARD_SEP_VISIBLE_MAX_DEG=7
NEW_TRANSIT_INDICATOR_ENABLED=true
NEW_TRANSIT_THRESHOLD_SECONDS=60

# Optional true-2D shadow diagnostics; never authoritative for public SEP/T0.
SHADOW_2D_ENABLED=false
SHADOW_2D_HORIZON_SECONDS=900
SHADOW_2D_SEGMENT_SECONDS=60
SHADOW_2D_LOCAL_SEGMENT_SECONDS=15
SHADOW_2D_SAFETY_MARGIN_DEG=0.052
SHADOW_2D_REFINEMENT_TARGET_DEG=7
